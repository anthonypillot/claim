# Runtime configuration for the adapter-node server. Local development continues to use the /api
# proxy and Vite origin, does not load analytics, and does not require these values.
PUBLIC_API_URL=https://api.claim.anthonypillot.com
PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.monitoring.anthonypillot.com/js/pa-D95gD7Xk4gbNpDXKDnm4m.js
PUBLIC_WEB_URL=https://claim.anthonypillot.com
ORIGIN=https://claim.anthonypillot.com
ROBOTS_ALLOW_INDEXING=true

# Server-only OpenTelemetry tracing. Leave the endpoint unset to disable the SDK locally and in tests.
# The OTLP HTTP/protobuf exporter appends /v1/traces to this collector origin.
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-k8s-infra-otel-agent.signoz:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production,k8s.namespace.name=claim
