{
  "name": "claim",
  "version": "1.0.0",
  "description": "Claim is a modern, fast, and efficient application.",
  "license": "ISC",
  "author": {
    "name": "Anthony Pillot",
    "url": "https://anthonypillot.com"
  },
  "workspaces": [
    "packages/**"
  ],
  "type": "module",
  "scripts": {
    "clean": "bun run --workspaces --if-present clean",
    "dev": "bun run --workspaces dev",
    "build": "bun run --workspaces build",
    "build:production": "bun run --workspaces build:production",
    "start": "bun run --workspaces start",
    "test": "bun run --workspaces test",
    "test:watch": "bun run --workspaces test:watch",
    "test:coverage": "bun run --workspaces test:coverage",
    "lint": "bun run --workspaces --if-present lint",
    "lint:fix": "bun run --workspaces --if-present lint:fix",
    "format": "bun run --workspaces --if-present format",
    "format:check": "bun run --workspaces --if-present format:check",
    "typecheck": "bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "semantic-release": "^25.0.8"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
