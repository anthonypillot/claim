# Runtime configuration for the adapter-node server. Local development continues to use the /api
# proxy and Vite origin, does not load analytics, and does not require these values.
PUBLIC_API_URL=https://api.claim.anthonypillot.com
PUBLIC_PLAUSIBLE_URL=https://plausible.monitoring.anthonypillot.com
PUBLIC_WEB_URL=https://claim.anthonypillot.com
ORIGIN=https://claim.anthonypillot.com
ROBOTS_ALLOW_INDEXING=true
