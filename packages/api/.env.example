# Copy to `.env` (Bun auto-loads it) and fill in the values. Run commands from `packages/api/`.
# `.env` itself is gitignored; this template is committed.

# --- Required ---

# Postgres connection string. Required wherever the database is used: the server's read/refresh
# routes and the db:migrate script (src/config.ts → requireDatabaseUrl).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/claim

# Shared secret guarding POST /giveaways/refresh (sent as the `x-refresh-token` header by the cron
# job). Required only when that route is hit (src/config.ts → requireRefreshToken). Use a long,
# random value in production.
REFRESH_TOKEN=change-me

# --- Optional ---

# HTTP port the server listens on. Default: 3000.
PORT=3000

# pino log level (trace|debug|info|warn|error|fatal). Default: debug in dev, info in production.
LOG_LEVEL=debug

# Set to `production` to disable pretty logging and enable production defaults. The `start` script
# sets this for you; leave unset for local `dev`.
# NODE_ENV=production
