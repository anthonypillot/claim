    "gsap": "^3.15.0",
    "import-in-the-middle": "^3.3.3",
    "mode-watcher": "^1.1.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
