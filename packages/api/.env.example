# From the repository root, copy this file to `packages/api/.env` and fill in the values.
# Bun auto-loads the resulting `.env`; run commands from the repository root unless noted otherwise.
# `.env` itself is gitignored; this template is committed.

# --- Required ---

# Postgres connection string. Required wherever the database is used: the read routes (which cache
# giveaways). drizzle-kit also reads it directly for db:migrate/db:push/db:studio.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/claim

# Public API origin. It defaults to localhost during development and is required in production.
PUBLIC_API_URL=https://api.claim.anthonypillot.com

# --- Optional ---

# HTTP port the server listens on. Default: 3000.
PORT=3000

# pino log level (trace|debug|info|warn|error|fatal). Default: debug in dev, info in production.
LOG_LEVEL=debug

# Set to `production` to disable pretty logging and enable production defaults. The `start` script
# sets this for you; leave unset for local `dev`.
# NODE_ENV=production

# Setting an OTLP endpoint enables server traces. Claim uses OTLP/HTTP and does not export logs or
# metrics; SigNoz derives its APM views from traces. Health and readiness probes are not traced.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_LOGS_EXPORTER=none
# OTEL_METRICS_EXPORTER=none
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=claim,deployment.environment.name=development
